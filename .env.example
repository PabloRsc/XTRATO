# XTRATO — exemplo de configuração local
# Copie para .env e substitua todos os valores CHANGE_ME.
# Nunca faça commit do arquivo .env.

APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
COOKIE_SECURE=false
APP_TIMEZONE=America/Sao_Paulo
SESSION_MAX_AGE=1209600

POSTGRES_DB=xtrato
POSTGRES_USER=xtrato
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_HEX_24

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

APP_PORT=8000
DOMAIN=localhost
