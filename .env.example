# XTRATO — variáveis para desenvolvimento local
# Copie este arquivo para .env e substitua os valores indicados.

APP_ENV=development
APP_SECRET_KEY=local-development-key-change-before-production
COOKIE_SECURE=false
APP_TIMEZONE=America/Sao_Paulo
SESSION_MAX_AGE=1209600

POSTGRES_DB=xtrato
POSTGRES_USER=xtrato
# Para desenvolvimento, gere um valor hexadecimal com: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD

APP_PORT=8000

# Usado somente no perfil opcional do Caddy em produção.
DOMAIN=localhost
